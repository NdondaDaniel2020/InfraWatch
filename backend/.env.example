# =============================================================================
# InfraWatch Backend - Environment Variables Template
# =============================================================================

# Ambiente de Execução (development, test, staging, production)
ENVIRONMENT=development
DEBUG=true

# Banco de Dados PostgreSQL 16+ com driver assíncrono asyncpg
DATABASE_URL=postgresql+asyncpg://infrawatch_user:infrawatch_secure_password_2026@localhost:5432/infrawatch_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_PRE_PING=true

# Redis 7+ (Streams, Pub/Sub, Lock Distribuído e Cache)
REDIS_URL=redis://:redis_secure_password_2026@localhost:6379/0

# Segurança, JWT e Criptografia
SECRET_KEY=infrawatch_insecure_dev_secret_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
