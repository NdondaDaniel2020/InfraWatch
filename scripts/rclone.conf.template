# =============================================================================
# InfraWatch - Template de Configuracao do rclone (Multi-Destino)
# Copie este arquivo para rclone.conf ou ~/.config/rclone/rclone.conf
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Remoto: Google Drive (Plano Gratuito 15GB ou Corporativo 2TB+)
# -----------------------------------------------------------------------------
[gdrive]
type = drive
scope = drive.file
# Para autenticar, execute uma vez no seu ambiente local com navegador:
# rclone config
# Ou insira as credenciais OAuth / Service Account geradas no Google Cloud Console:
# client_id = <SEU_CLIENT_ID>
# client_secret = <SEU_CLIENT_SECRET>
# token = {"access_token":"...","token_type":"Bearer","refresh_token":"...","expiry":"..."}

# -----------------------------------------------------------------------------
# 2. Remoto: Cloudflare R2 (10 GB Free Tier Permanente - S3 Compatible - Zero Egress)
# -----------------------------------------------------------------------------
[r2]
type = s3
provider = Cloudflare
env_auth = false
access_key_id = ${R2_ACCESS_KEY_ID:-seu_r2_access_key_id}
secret_access_key = ${R2_SECRET_ACCESS_KEY:-seu_r2_secret_access_key}
endpoint = ${R2_ENDPOINT:-https://<SEU_ACCOUNT_ID>.r2.cloudflarestorage.com}
acl = private

# -----------------------------------------------------------------------------
# 3. Remoto: AWS S3 (Plano de Estudante / AWS Educate / Producao)
# -----------------------------------------------------------------------------
[aws_s3]
type = s3
provider = AWS
env_auth = false
access_key_id = ${AWS_ACCESS_KEY_ID:-seu_aws_access_key_id}
secret_access_key = ${AWS_SECRET_ACCESS_KEY:-seu_aws_secret_access_key}
region = ${AWS_REGION:-us-east-1}
acl = private
