# ==========================================
# INFRAWATCH - ENVIRONMENT CONFIGURATION
# ==========================================

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
FORWARDED_ALLOW_IPS=*

# Database (PostgreSQL / TimescaleDB)
POSTGRES_USER=infrawatch_user
POSTGRES_PASSWORD=infrawatch_secure_password
POSTGRES_DB=infrawatch_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://infrawatch_user:infrawatch_secure_password@localhost:5432/infrawatch_db

# Redis (Streams, Locks, Cache & Blacklist)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Security & Authentication (JWT & Argon2)
JWT_SECRET_KEY=change_this_to_a_super_secret_high_entropy_key_in_production_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# GLPI ITSM Integration (Default Configuration)
GLPI_BASE_URL=https://glpi.rcsangola.co.ao/apirest.php
GLPI_APP_TOKEN=your_glpi_app_token_here
GLPI_USER_TOKEN=your_glpi_user_token_here
GLPI_TIMEOUT_SECONDS=10

# Telemetry & Probes Configuration
DEFAULT_PING_TIMEOUT_SECONDS=2.0
DEFAULT_HTTP_TIMEOUT_SECONDS=5.0
DEFAULT_DNS_TIMEOUT_SECONDS=3.0
MAX_CONCURRENT_PROBES=250

# Prometheus Metrics Security
PROMETHEUS_METRICS_USER=metrics_admin
PROMETHEUS_METRICS_PASSWORD=metrics_secure_password
