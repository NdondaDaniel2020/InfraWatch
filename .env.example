# =============================================================================
# INFRAWATCH - ENVIRONMENT CONFIGURATION
# =============================================================================

# Application
ENVIRONMENT=development          # development | test | production
APP_NAME="InfraWatch"
APP_VERSION="0.1.0"
DEBUG=true
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
FORWARDED_ALLOW_IPS=*

# CORS (Frontend Integration)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS,HEAD
CORS_ALLOWED_HEADERS=Authorization,Content-Type,Origin,Accept

# Database (PostgreSQL / TimescaleDB)
POSTGRES_USER=infrawatch_user
POSTGRES_PASSWORD=infrawatch_secure_password
POSTGRES_DB=infrawatch_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://infrawatch_user:infrawatch_secure_password@localhost:5432/infrawatch_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# Redis (Streams, Locks, Cache & Blacklist)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20

# Security & Authentication (JWT & Argon2id)
JWT_SECRET_KEY=change_this_to_a_super_secret_high_entropy_key_in_production_min_32_chars
REFRESH_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_REFRESH_GRACE_PERIOD_SECONDS=10

# Password Policy & Argon2 Hashing
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=65536          # 64MB; use 19456 para containers com pouca memória
ARGON2_PARALLELISM=4
PASSWORD_MIN_LENGTH=8

# Login Rate Limiting & Account Lockout (Dual-Key)
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15
LOGIN_BLOCK_DURATION_MINUTES=30

# Initial Seed (First deploy)
RUN_SEED_ON_STARTUP=true
INITIAL_SUPERADMIN_EMAIL=noc-admin@rcsangola.co.ao
INITIAL_SUPERADMIN_PASSWORD=admin123
INITIAL_ORG_NAME="RCS Angola - NOC Central"

# GLPI ITSM Integration
GLPI_ENABLED=true
GLPI_BASE_URL=https://glpi.rcsangola.co.ao/apirest.php
GLPI_APP_TOKEN=your_glpi_app_token_here
GLPI_USER_TOKEN=your_glpi_user_token_here
GLPI_TIMEOUT_SECONDS=10

# Zabbix JSON-RPC Integration (Hardware Telemetry)
ZABBIX_ENABLED=false
ZABBIX_NOTIFY_STARTUP=false
ZABBIX_API_URL=http://localhost:8081/api_jsonrpc.php # ou https://zabbix.rcsangola.co.ao/api_jsonrpc.php
ZABBIX_API_TOKEN=your_zabbix_api_token_here
ZABBIX_USER=Admin
ZABBIX_PASSWORD=zabbix
ZABBIX_TIMEOUT_SECONDS=10
ZABBIX_WEBHOOK_SECRET=infrawatch-zabbix-webhook-secret-change-in-production

# Notifications (SMTP, Telegram, WhatsApp, Webhooks)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noc-alerts@rcsangola.co.ao
SMTP_TLS=true
SMTP_DEFAULT_RECIPIENT=noc-team@rcsangola.co.ao

TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

WHATSAPP_ENABLED=false
WHATSAPP_GATEWAY_URL=http://localhost:8085/message/sendText/infrawatch
WHATSAPP_API_TOKEN=
WHATSAPP_DEFAULT_RECIPIENT=

DEFAULT_WEBHOOK_URL=

# Telemetry & Probes Configuration
DEFAULT_PING_TIMEOUT_SECONDS=2.0
DEFAULT_HTTP_TIMEOUT_SECONDS=5.0
DEFAULT_DNS_TIMEOUT_SECONDS=3.0
MAX_CONCURRENT_PROBES=250

# Prometheus Metrics Security
PROMETHEUS_METRICS_USER=metrics_admin
PROMETHEUS_METRICS_PASSWORD=metrics_secure_password
