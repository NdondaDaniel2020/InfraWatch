# =============================================================================
# InfraWatch Frontend - Production Environment Variables Template
# =============================================================================

# Modo de Execução do Vite
VITE_ENVIRONMENT=production

# Título da Aplicação
VITE_APP_TITLE="InfraWatch NOC"

# URL Base da API Backend FastAPI (Vazio = Same-Origin relativo via Gateway Nginx)
VITE_API_URL=

# URL de Eventos em Tempo Real (Server-Sent Events - SSE relativo via Gateway Nginx)
VITE_SSE_URL=/api/v1/events/stream

# URL Base de WebSockets (Vazio = Detectado dinamicamente com ws:// ou wss://)
VITE_WS_BASE_URL=
