# =============================================================================
# InfraWatch Frontend - Environment Variables Template
# =============================================================================

# Modo de Execução do Vite (development, production)
VITE_ENVIRONMENT=development

# Título da Aplicação
VITE_APP_TITLE="InfraWatch NOC"

# URL Base da API Backend FastAPI
# Standalone local: http://localhost:8000
# Produção Same-Origin (Gateway Nginx): deixar em branco
VITE_API_URL=http://localhost:8000

# URL de Eventos em Tempo Real (Server-Sent Events - SSE)
# Standalone local: http://localhost:8000/api/v1/events/stream
# Produção Same-Origin (Gateway Nginx): /api/v1/events/stream
VITE_SSE_URL=http://localhost:8000/api/v1/events/stream

# URL Base para WebSockets (detectado dinamicamente caso omitido)
# VITE_WS_BASE_URL=ws://localhost:8000
